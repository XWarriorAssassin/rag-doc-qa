DATABASE_URL=
#Neon URL
PORT=4000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required — no default/fallback. Any chat-capable OpenRouter model slug
# works (this project runs on free-tier ones, e.g. an OpenRouter :free
# model). Backend refuses to start if this is unset.
CHAT_MODEL=

# Signs/verifies session JWTs (see src/lib/auth.ts). Generate a real one
# with: openssl rand -base64 48
# Rotating this invalidates every existing session — the only revocation
# mechanism this project has, since there's no server-side session store.
JWT_SECRET=

# Exact origin of the deployed frontend (e.g. https://your-app.vercel.app),
# no trailing slash. Must be an exact origin, not "*" — a credentialed CORS
# request (cookies) cannot use the wildcard. Local dev: http://localhost:5173
CORS_ORIGIN=

# development | production. Controls the auth cookie's Secure/SameSite
# attributes (see src/lib/auth.ts's cookieOptions) — set to "production" on
# Render, leave unset/"development" locally.
NODE_ENV=